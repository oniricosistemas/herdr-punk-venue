{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "preview": "layouts/punk-venue.svg",
  "theme": "punk-venue",
  "background": "canvas",
  "terminal_padding": [10, 10],
  "divider": {"width": 1, "color": "border"},
  "children": [
    {
      "id": "sidebar", "type": "column", "size": {"px": 176},
      "min": 44, "max": 360, "background": "chrome", "resizable": false,
      "children": [
        {"id": "brand", "type": "block", "size": {"px": 42}, "window_drag": true, "content": {"mod": "neon-brand"}},
        {"id": "sidebar-lists", "type": "column", "children": [
          {"id": "spaces", "type": "block", "size": {"weight": 1}, "min": 60, "content": {"mod": "spaces"}},
          {"id": "agents", "type": "block", "size": {"weight": 1}, "min": 60, "content": {"mod": "agents"}}
        ]},
        {"id": "sidebar-footer", "type": "block", "size": {"px": 69}, "content": {"mod": "workspace-chrome", "props": {"footer": true}}}
      ]
    },
    {
      "id": "work", "type": "column", "resizable": false,
      "children": [
        {"id": "tabs", "type": "block", "size": {"px": 42}, "window_drag": true, "content": {"mod": "tabs"}},
        {
          "id": "work-body", "type": "row", "padding": 8, "gap": 8,
          "children": [
            {
              "id": "dashboard", "type": "column", "size": {"weight": 1}, "gap": 8,
              "children": [
                {
                  "id": "node-map", "type": "block", "size": {"weight": 2}, "min": 260,
                  "background": "canvas",
                  "border": {"width": 1, "color": "border"}, "radius": 4,
                  "focus": {"border": {"width": 1, "color": "accent"}},
                  "content": {"mod": "punk-venue"}
                },
                {
                  "id": "main", "type": "block", "size": {"weight": 3}, "min": 100,
                  "content": {"tab": "active", "pane": {
                    "gap": 6, "radius": 4, "background": "background", "lone": true,
                    "border": {"width": 1, "color": "border"},
                    "focus": {"width": 1, "color": "accent"},
                    "header": {"content": {"mod": "pane"}, "height": 28, "position": "top", "reveal": "always"}
                  }}
                }
              ]
            },
            {
              "id": "panel", "type": "column", "hidden": true,
              "size": {"px": 300}, "min": 280, "max": 900,
              "children": [
                {"id": "panel-body", "type": "stack", "active": "files", "children": [
                  {"id": "files", "type": "block", "content": {"mod": "files"}},
                  {"id": "changes", "type": "block", "content": {"mod": "changes"}}
                ]}
              ]
            }
          ]
        },
        {"id": "status", "type": "block", "size": {"px": 28}, "content": {"mod": "workspace-status"}}
      ]
    }
  ]
}
